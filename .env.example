# Telegram
TOKEN='YOUR_BOT_TOKEN'
ADMIN_TELEGRAM_USER_ID=YOUR_TELEGRAM_USER_ID

# Model gateway (OpenAI-compatible)
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_MODEL=opencode-go/deepseek-v4.1-flash
# Judge for `shinnku eval run`; use a different model family than LLM_MODEL
LLM_MODEL_JUDGE=opencode-go/glm-5.3
# The few merging calls of `shinnku corpus distill`; empty means LLM_MODEL
#LLM_MODEL_SLOW=opencode-go/glm-5.3
# Backup for the bot and `shinnku chat`: answers for 30 minutes after LLM_MODEL
# fails (quota gone, gateway down), then LLM_MODEL is tried again; empty means none
LLM_MODEL_FALLBACK=codex/gpt-6.1-sol
# Inner monologue before each reply: on / off
#LLM_THINKING=on

# Behaviour
#NAME_TRIGGERS=真红,shinnku
#ALLOWED_CHAT_IDS=-1001234567890
#ALLOW_PRIVATE=on
#TIMEZONE=Asia/Shanghai
# People cards and days of diary shown per reply
#PEOPLE_CARDS=4
#DIARY_DAYS=3
# Joining in uncalled (where /talk is above 0)
#YIELD_TO_OWNER_MIN=10
#PROACTIVE_CALLS_PER_HOUR=12
#PROACTIVE_CALLS_PER_DAY=150

# Corpus
#EXPORT_DIR=~/tg-export
#DATA_DIR=data
#EMBED_MODEL=BAAI/bge-small-zh-v1.5
#ANCHOR_SCENES=520
#RECALL_SCENES=24

# --- Only read by the old bot (src/main.py); remove after the switch to v2 ---
NAME='YOUR_BOT_NAME'
IS_MAINTENANCE=''
OPENAI_API_KEY='sk-xxxxxxxxxxxxxxxxxxxxxxxx'
OPENAI_MODEL='gpt-5.5'
api_id=
api_hash=
